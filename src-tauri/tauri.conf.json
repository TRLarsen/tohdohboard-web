{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TohdohBoard",
  "identifier": "dev.tohdohboard.app",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../out",
    "beforeBuildCommand": "npm run build:static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TohdohBoard",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
